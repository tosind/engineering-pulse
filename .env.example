# Required for live OpenRouter reviews. If omitted, Engineering Pulse runs in deterministic demo mode.
OPENROUTER_API_KEY=

# Models are configurable so reviewers can swap models without touching code.
FE_MODEL=deepseek/deepseek-chat-v3.1
BE_MODEL=deepseek/deepseek-chat-v3.1
LEAD_MODEL=deepseek/deepseek-r1

# Optional
PORT=3088
DEMO_MODE=
DATABASE_PATH=./data/engineering-pulse.db
HOST=127.0.0.1
# Required for production; keep empty for local demos. Use independently generated secrets.
PULSE_API_TOKEN=
# Comma-separated owner/repo names approved for model processing.
GITHUB_REPOSITORIES=
# Optional read-only token for private repositories. Never commit it.
GITHUB_TOKEN=
